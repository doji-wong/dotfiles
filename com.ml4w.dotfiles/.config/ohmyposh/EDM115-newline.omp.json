{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "async": true,
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#eae7de",
          "style": "plain",
          "template": "╭─",
          "type": "text"
        },
        {
          "background": "#00040e",
          "foreground": "#eae7de",
          "leading_diamond": "",
          "style": "diamond",
          "template": "{{ .UserName }}",
          "type": "session"
        },
        {
          "background": "#00040e",
          "foreground": "#ff5555",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "󱐋",
          "type": "root"
        },
        {
          "background": "#00040e",
          "foreground": "#eae7de",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "{{ .Icon }}  ",
          "type": "os"
        },
        {
          "background": "#bd93f9",
          "foreground": "#00040e",
          "options": {
            "display_root": true,
            "style": "full"
          },
          "style": "diamond",
          "template": " 󰉖 {{ path .Path .Location }}",
          "trailing_diamond": "",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#f1fa8c",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": "󰄉 {{ .CurrentDate | date .Format }} •",
          "type": "time"
        },
        {
          "background": "#f1fa8c",
          "foreground": "#00040e",
          "options": {
            "always_enabled": true,
            "style": "austin",
            "threshold": 500
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }}",
          "trailing_diamond": "",
          "type": "executiontime"
        },
        {
          "background": "#ffb86c",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": " ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#50fa7b> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#ff5555> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<#00040e>  {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<#00040e>  {{ .Staging.String }}</>{{ end }}",
          "trailing_diamond": "",
          "type": "git"
        },
        {
          "background": "#50fa7b",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "node"
        },
        {
          "background": "#ff5555",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "npm"
        },
        {
          "background": "#ffb86c",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "pnpm"
        },
        {
          "background": "#ff79c6",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files",
            "extensions": [
              "bun.lockb",
              "bun.lock"
            ]
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "bun"
        },
        {
          "background": "#50fa7b",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files",
            "extensions": [
              "deno.json",
              "deno.jsonc"
            ]
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "deno"
        },
        {
          "background": "#50fa7b",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files",
            "extensions": [
              "yarn.lock"
            ]
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "yarn"
        },
        {
          "background": "#50fa7b",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h",
            "display_mode": "files"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "python"
        },
        {
          "background": "#ff79c6",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "java"
        },
        {
          "background": "#6272a4",
          "foreground": "#eae7de",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "lua"
        },
        {
          "background": "#ffb86c",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "rust"
        },
        {
          "background": "#ffb86c",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "zig"
        },
        {
          "background": "#8be9fd",
          "foreground": "#00040e",
          "leading_diamond": "",
          "options": {
            "display_mode": "files"
          },
          "style": "diamond",
          "template": " {{ .Context }}",
          "trailing_diamond": "",
          "type": "docker"
        },
        {
          "background": "#6272a4",
          "foreground": "#eae7de",
          "leading_diamond": "",
          "options": {
            "cache_duration": "2h"
          },
          "style": "diamond",
          "template": " {{ .Full }}",
          "trailing_diamond": "",
          "type": "php"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#eae7de",
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": "╰─ ❯❯",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "enable_cursor_positioning": true,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#eae7de",
    "template": "    ❯ "
  },
  "shell_integration": true,
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#eae7de",
    "newline": true,
    "template": "   ❯❯ {{ .AbsolutePWD }}\n    ❯ "
  },
  "upgrade": {
    "auto": false,
    "interval": "168h",
    "notice": false,
    "source": "cdn"
  },
  "version": 4,
  "palette": {
    "color0": "#121318",
    "color1": "",
    "color2": "",
    "color3": "",
    "color4": "",
    "color5": "",
    "color6": "",
    "color7": "",
    "color8": "",
    "color9": "",
    "color10": "#b4c5ff",
    "color11": "",
    "color12": "",
    "color13": "#01174b",
    "color14": "",
    "color15": "#e3e2e9"
  }
}
